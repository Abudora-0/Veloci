# Rust / Tauri build output (regenerated by `cargo build` / `npm run tauri build`)
/app/src-tauri/target/
/app/src-tauri/gen/schemas/

# Node / Vite
/app/node_modules/
/app/dist/
*.local
npm-debug.log*

# Python engine
/engine/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# PyInstaller output (the frozen sidecar binary -- see README's "Building a
# portable release" section for how to regenerate it)
/engine/build/
/engine/dist/
/engine/*.spec
/app/src-tauri/binaries/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
